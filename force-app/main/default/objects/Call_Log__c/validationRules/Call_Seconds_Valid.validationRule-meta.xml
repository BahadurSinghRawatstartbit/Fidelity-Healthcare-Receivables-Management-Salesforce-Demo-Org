<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Call_Seconds_Valid</fullName>
    <active>true</active>
    <description>Seconds must be between 0 and 59.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Call_Duration_Seconds__c)), OR(Call_Duration_Seconds__c &lt; 0, Call_Duration_Seconds__c &gt; 59))</errorConditionFormula>
    <errorDisplayField>Call_Duration_Seconds__c</errorDisplayField>
    <errorMessage>Seconds must be between 0 and 59. Put whole minutes in the Minutes field.</errorMessage>
</ValidationRule>
