    <decisions>
        <name>Outcome_Router</name>
        <label>Outcome Router</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>No Match</defaultConnectorLabel>
        <rules>
            <name>Outcome_Interested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Call_Outcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Interested</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Interested</targetReference>
            </connector>
            <label>Interested</label>
        </rules>
        <rules>
            <name>Outcome_Not_Interested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Call_Outcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not Interested</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Not_Interested</targetReference>
            </connector>
            <label>Not Interested</label>
        </rules>
        <rules>
            <name>Outcome_Followup_Or_Callback</name>
            <conditionLogic>1 or 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Call_Outcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Follow-up Required</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Call_Outcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Call Back</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Followup</targetReference>
            </connector>
            <label>Follow-up Required or Call Back</label>
        </rules>
        <rules>
            <name>Outcome_Meeting_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Call_Outcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Meeting Requested</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Meeting_Requested</targetReference>
            </connector>
            <label>Meeting Requested</label>
        </rules>
        <rules>
            <name>Outcome_Meeting_Scheduled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Call_Outcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Meeting Scheduled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Meeting_Scheduled</targetReference>
            </connector>
            <label>Meeting Scheduled</label>
        </rules>
        <rules>
            <name>Outcome_No_Response</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Call_Outcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No Response</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Retry_Task</targetReference>
            </connector>
            <label>No Response</label>
        </rules>
    </decisions>
    <environments>Default</environments>
