        <locationX>50</locationX>
        <locationY>266</locationY>
        <actionName>Lead.Meeting_Confirmation_Email</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Update_Lead_Status_Meeting_Scheduled</targetReference>
        </connector>
        <faultConnector><targetReference>Update_Lead_Status_Meeting_Scheduled</targetReference></faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Lead.Meeting_Confirmation_Email</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>Meeting_End_DateTime</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.Meeting_Date_Time__c} + (IF(ISBLANK({!$Record.Meeting_Duration_Minutes__c}), 30, {!$Record.Meeting_Duration_Minutes__c}) / 1440)</expression>
    </formulas>
    <interviewLabel>Meeting Scheduling And Reminders {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Meeting Scheduling And Reminders</label>
    <processType>AutoLaunchedFlow</processType>
    <decisions>
        <name>Has_Previous_Meetings</name>
        <label>Has Previous Meetings?</label>
        <locationX>50</locationX>
        <locationY>120</locationY>
        <defaultConnector><targetReference>Create_Discovery_Meeting_Event</targetReference></defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Previous_Future_Meetings</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Delete_Previous_Future_Meeting</targetReference></connector>
            <label>Found</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Previous_Future_Meetings</name>
        <label>Get Previous Future Meetings</label>
        <locationX>50</locationX>
        <locationY>60</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Has_Previous_Meetings</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhoId</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>EqualTo</operator>
            <value><stringValue>Discovery Meeting</stringValue></value>
        </filters>
        <filters>
            <field>StartDateTime</field>
            <operator>GreaterThan</operator>
            <value><elementReference>$Flow.CurrentDateTime</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Event</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordDeletes>
        <name>Delete_Previous_Future_Meeting</name>
        <label>Delete Previous Future Meetings</label>
        <locationX>50</locationX>
        <locationY>180</locationY>
        <connector><targetReference>Create_Discovery_Meeting_Event</targetReference></connector>
        <inputReference>Get_Previous_Future_Meetings</inputReference>
    </recordDeletes>
    <recordCreates>
        <name>Create_Discovery_Meeting_Event</name>
        <label>Create Discovery Meeting Event</label>
        <locationX>50</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Send_Meeting_Confirmation</targetReference>
        </connector>
        <inputAssignments>
            <field>EndDateTime</field>
            <value>
                <elementReference>Meeting_End_DateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StartDateTime</field>
            <value>
                <elementReference>$Record.Meeting_Date_Time__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Discovery Meeting</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Event</object>
    </recordCreates>
    <recordUpdates>
        <name>Update_Lead_Status_Meeting_Scheduled</name>
        <label>Update Lead Status - Meeting Scheduled</label>
        <locationX>50</locationX>
        <locationY>374</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Discovery Meeting Scheduled</stringValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Previous_Future_Meetings</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK({!$Record.Meeting_Date_Time__c})), OR(ISNEW(), ISCHANGED({!$Record.Meeting_Date_Time__c}), ISCHANGED({!$Record.Meeting_Duration_Minutes__c})))</filterFormula>
        <filterLogic>formula_evaluates_to_true</filterLogic>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
