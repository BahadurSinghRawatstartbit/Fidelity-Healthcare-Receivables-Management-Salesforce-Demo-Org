    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>Meeting_End_DateTime</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.Meeting_Date_Time__c} + (30 / 1440)</expression>
    </formulas>
    <interviewLabel>Meeting Scheduling And Reminders {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Meeting Scheduling And Reminders</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Discovery_Meeting_Event</name>
        <label>Create Discovery Meeting Event</label>
        <locationX>50</locationX>
        <locationY>158</locationY>
        <connector>
            <targetReference>Send_Meeting_Confirmation</targetReference>
        </connector>
        <inputAssignments>
            <field>EndDateTime</field>
            <value>
                <elementReference>Meeting_End_DateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StartDateTime</field>
            <value>
                <elementReference>$Record.Meeting_Date_Time__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Discovery Meeting</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Event</object>
    </recordCreates>
    <recordUpdates>
        <name>Update_Lead_Status_Meeting_Scheduled</name>
        <label>Update Lead Status - Meeting Scheduled</label>
        <locationX>50</locationX>
        <locationY>374</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Discovery Meeting Scheduled</stringValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Create_Discovery_Meeting_Event</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Meeting_Date_Time__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Reminder_24_Hours_Before</name>
            <connector>
                <targetReference>Send_Reminder_24h</targetReference>
            </connector>
            <label>24 Hours Before</label>
            <offsetNumber>-24</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <recordField>Meeting_Date_Time__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Reminder_1_Hour_Before</name>
            <connector>
                <targetReference>Send_Reminder_1h</targetReference>
